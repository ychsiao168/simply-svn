{
  "name": "simply-svn",
  "displayName": "Simply SVN",
  "description": "SVN integration that feels like built-in Git",
  "version": "0.1.0",
  "publisher": "your-publisher-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/simply-svn"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "svn",
    "subversion",
    "scm",
    "source control",
    "version control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplySvn.refresh",
        "title": "Refresh",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "simplySvn.commit",
        "title": "Commit",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "simplySvn.update",
        "title": "Update",
        "category": "SVN",
        "icon": "$(cloud-download)"
      },
      {
        "command": "simplySvn.revert",
        "title": "Revert",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "simplySvn.add",
        "title": "Add",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "simplySvn.delete",
        "title": "Delete",
        "category": "SVN",
        "icon": "$(trash)"
      },
      {
        "command": "simplySvn.openFile",
        "title": "Open File",
        "category": "SVN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "simplySvn.openChange",
        "title": "Open Changes",
        "category": "SVN",
        "icon": "$(diff)"
      },
      {
        "command": "simplySvn.switchBranch",
        "title": "Switch Branch",
        "category": "SVN",
        "icon": "$(git-branch)"
      },
      {
        "command": "simplySvn.createBranch",
        "title": "Create Branch",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "simplySvn.resolveTheirs",
        "title": "Accept Theirs",
        "category": "SVN",
        "icon": "$(cloud-download)"
      },
      {
        "command": "simplySvn.resolveMine",
        "title": "Accept Mine",
        "category": "SVN",
        "icon": "$(edit)"
      },
      {
        "command": "simplySvn.resolveWorking",
        "title": "Mark Resolved",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "simplySvn.refreshLog",
        "title": "Refresh Log",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "simplySvn.showProperties",
        "title": "Show Properties",
        "category": "SVN",
        "icon": "$(symbol-property)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "simplySvn.refresh",
          "group": "navigation",
          "when": "scmProvider == svn"
        },
        {
          "command": "simplySvn.commit",
          "group": "navigation",
          "when": "scmProvider == svn"
        },
        {
          "command": "simplySvn.update",
          "group": "navigation",
          "when": "scmProvider == svn"
        }
      ],
      "view/title": [
        {
          "command": "simplySvn.refreshLog",
          "group": "navigation",
          "when": "view == simplySvn.log"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "simplySvn.openFile",
          "group": "navigation",
          "when": "scmProvider == svn"
        },
        {
          "command": "simplySvn.openChange",
          "group": "navigation",
          "when": "scmProvider == svn"
        },
        {
          "command": "simplySvn.add",
          "group": "inline",
          "when": "scmProvider == svn && scmResourceGroup == unversioned"
        },
        {
          "command": "simplySvn.add",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == unversioned"
        },
        {
          "command": "simplySvn.revert",
          "group": "inline",
          "when": "scmProvider == svn && scmResourceGroup == changes"
        },
        {
          "command": "simplySvn.revert",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == changes"
        },
        {
          "command": "simplySvn.delete",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == changes"
        },
        {
          "command": "simplySvn.resolveTheirs",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == conflicts"
        },
        {
          "command": "simplySvn.resolveMine",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == conflicts"
        },
        {
          "command": "simplySvn.resolveWorking",
          "group": "1_modification",
          "when": "scmProvider == svn && scmResourceGroup == conflicts"
        },
        {
          "command": "simplySvn.showProperties",
          "group": "2_view",
          "when": "scmProvider == svn && scmResourceGroup != unversioned"
        }
      ],
      "explorer/context": [
        {
          "command": "simplySvn.showProperties",
          "group": "7_svn",
          "when": "resourceScheme == file"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "simplySvn.log",
          "name": "SVN Log",
          "icon": "$(history)",
          "when": "simplySvn.hasRepository"
        }
      ]
    },
    "configuration": {
      "title": "Simply SVN",
      "properties": {
        "simplySvn.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SVN integration"
        },
        "simplySvn.path": {
          "type": "string",
          "default": "svn",
          "description": "Path to the svn executable"
        },
        "simplySvn.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh status when files change"
        },
        "simplySvn.refreshInterval": {
          "type": "number",
          "default": 3000,
          "description": "Auto-refresh interval in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run generate-icon && npm run package:ext",
    "compile": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "package:ext": "node esbuild.js --production",
    "generate-icon": "npx sharp-cli -i icon.svg -o icon.png -- resize 128 128",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.2"
  }
}
